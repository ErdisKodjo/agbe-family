# ============================================================
# AGBE Family — Variables d'environnement
# Copiez ce fichier en `.env` puis adaptez les valeurs.
#   cp .env.example .env
# ============================================================

# --- Base de données SQLite ---
# Chemin absolu en développement, chemin conteneur en production (géré par docker-compose).
DATABASE_URL=file:/home/z/my-project/db/custom.db

# --- Serveur ---
PORT=3000
HOSTNAME=0.0.0.0

# --- Production : compte Admin Général (premier démarrage uniquement) ---
# Utilisé par docker/entrypoint.sh → scripts/bootstrap-admin.mjs si la base est vide.
# Le mot de passe est provisoire : changement obligatoire à la première connexion.
ADMIN_PHONE=+22890101010
ADMIN_PASSWORD=AgbeAdmin@2026
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=AGBE

# --- Production : Nginx (deploy/nginx.conf) ---
# DOMAIN=agbe.family

# --- Production : copie hors-site des sauvegardes (optionnel, recommandé) ---
# Destination rclone — vide = désactivée.
#  - VPS (docker-compose) : conteneur « backup » dédié ; créez d'abord
#    deploy/rclone.conf (modèle : deploy/rclone.conf.example).
#  - PaaS (Railway/Render, cf. docs/DEPLOIEMENT.md § 8.5) : boucle intégrée à
#    l'entrypoint ; la config rclone se pose par variables RCLONE_CONFIG_*.
# BACKUP_REMOTE=b2:agbe-backups
